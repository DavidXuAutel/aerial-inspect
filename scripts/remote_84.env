#!/usr/bin/env bash
# Offsite 84: Mac → cloudflared Access → ssh-84.david-x.com → 10.229.20.84
#   source scripts/remote_84.env
# Backup (125 jump): export AERIAL_SSH_HOST=cursor-84-via-125
# LAN: export AERIAL_SSH_HOST=cursor-84-lan

export AERIAL_SSH_HOST="${AERIAL_SSH_HOST:-cursor-84-public}"
export AERIAL_SSH_TARGET="${AERIAL_SSH_TARGET:-ubantu@10.229.20.84}"
export AERIAL_REMOTE_ROOT="${AERIAL_REMOTE_ROOT:-~/Projects/aerial-inspect}"
export AERIAL_RSYNC_SSH="${AERIAL_RSYNC_SSH:-ssh}"
export AERIAL_RSYNC_REMOTE="${AERIAL_RSYNC_REMOTE:-${AERIAL_SSH_HOST}}"
export AIRSIM_PUBLIC_HOST="${AIRSIM_PUBLIC_HOST:-10.229.20.84}"

aerial_ssh_84() {
  ssh "${AERIAL_SSH_HOST}" "$@"
}

aerial_rsync_to_84() {
  rsync -az -e "${AERIAL_RSYNC_SSH}" "$@"
}
